<?xml version="1.0" encoding="utf-8"?>
<!-- Установщик MSI Sphaera Commander (ТЗ §5, Ф4). WiX Toolset 6:
     установка тула и сборка — см. ci.yml (шаг «Установщик MSI (WiX)»):
     тул 6.x глобально + расширения WixToolset.UI.wixext/6.0.2 и
     WixToolset.Util.wixext/6.0.2,
     wix build: -arch x64 -d AppVersion=0.22.2 -ext WixToolset.UI.wixext
                -ext WixToolset.Util.wixext -culture ru-ru
                -out dist-installer/SphaeraCommander-0.22.2.msi
                win64/installer.wxs win64/.harvest.wxs
     UpgradeCode НЕ менять: по нему MajorUpgrade находит прежние версии.
     Конфиг пользователя (%APPDATA%\SphaeraCommander) MSI не трогает —
     переживает обновление; удаление настроек — решение пользователя.
     В дистрибутив вшиты rclone.exe (рядом с exe, кладёт fetch-redist.ps1)
     и redist/winfsp.msi: если WinFsp в системе нет, он ставится тихо
     кастом-действием InstallWinFsp (Return="ignore" — при неудаче
     приложение само вежливо сообщит подсказкой; смок проверяет реестр). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Sphaera Commander"
           Manufacturer="Sphaera"
           Version="$(var.AppVersion)"
           UpgradeCode="2889DF8D-591E-454C-BFDF-7DFF20F0C879"
           Scope="perMachine"
           Compressed="yes"
           Language="1049"
           Codepage="1251">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="[ProductName]: уже установлена более новая версия." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.exe" SourceFile="win64\sphaera-commander.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/TDots9791/Sphaera-Commander" />

    <!-- WinFsp уже стоит? (его x86-MSI пишет ключ в WOW6432Node) -->
    <Property Id="WINFSPPRESENT" Secure="yes">
      <RegistrySearch Id="WinFspReg" Root="HKLM"
                      Key="SOFTWARE\WOW6432Node\WinFsp" Name="InstallDir"
                      Type="raw" Bitness="always32" />
    </Property>

    <!-- тихая установка WinFsp из redist: команда готовится немедленным
         действием, исполняется отложенным QuietExec64 (util-расширение,
         WixCA) уже с правами машины -->
    <!-- QuietExec64 читает свойство, названное как само действие -->
    <CustomAction Id="SetWinFspCmd" Property="InstallWinFsp"
                  Value="&quot;[SystemFolder]msiexec.exe&quot; /i &quot;[INSTALLFOLDER]redist\winfsp.msi&quot; /qn /norestart"
                  Execute="immediate" />
    <CustomAction Id="InstallWinFsp" BinaryRef="WixCA" DllEntry="QuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="SetWinFspCmd" Before="InstallInitialize"
              Condition="NOT Installed AND NOT WINFSPPRESENT" />
      <Custom Action="InstallWinFsp" After="InstallFiles"
              Condition="NOT Installed AND NOT WINFSPPRESENT" />
    </InstallExecuteSequence>

    <Launch Condition="Installed OR VersionNT &gt;= 603"
            Message="Требуется Windows 10 или новее." />

    <WixVariable Id="WixUILicenseRtf" Value="win64\license.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuDir" Name="Sphaera Commander">
        <Component Id="StartMenuShortcut" Guid="D285A91C-8EE7-4882-97F3-2681CCA2EAE4">
          <Shortcut Id="StartMenuExe" Name="Sphaera Commander"
                    Description="Sphaera Commander"
                    Target="[INSTALLFOLDER]SphaeraCommander.exe"
                    WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.exe" />
          <RemoveFolder Id="RemoveMenuDir" Directory="MenuDir" On="uninstall" />
          <RegistryValue Root="HKMU" Key="Software\Sphaera\SphaeraCommander"
                         Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="424CA49F-7AAF-4F8F-BC3F-D481A66A6A1A">
        <Shortcut Id="DesktopExe" Name="Sphaera Commander"
                  Description="Sphaera Commander"
                  Target="[INSTALLFOLDER]SphaeraCommander.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.exe" />
        <RegistryValue Root="HKMU" Key="Software\Sphaera\SphaeraCommander"
                       Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- фирменный шрифт айдентики (PT Serif, ParaType, лицензия OFL —
         текст ставится рядом, win64/fonts/OFL.txt) -->
    <StandardDirectory Id="FontsFolder">
      <Component Id="PTSerifFont" Guid="9ACA35BA-A327-4B10-BD57-51B690534BAA">
        <File Id="PTSerifRegular.ttf" Source="win64\fonts\PT_Serif-Web-Regular.ttf" TrueType="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts"
                       Name="PT Serif (TrueType)" Type="string"
                       Value="PT_Serif-Web-Regular.ttf" />
      </Component>
    </StandardDirectory>

    <Component Id="FontLicense" Guid="79F996B3-9C13-4F56-94A3-CC84994FA86B"
               Directory="INSTALLFOLDER">
      <File Id="PTSerifOFL.txt" Source="win64\fonts\OFL.txt" Name="PT_Serif-OFL.txt" />
    </Component>

    <!-- «Открыть в Sphaera Commander» в контекстном меню папок —
         Windows-эквивалент MimeType=inode/directory -->
    <Component Id="DirAssociation" Guid="24B5F593-3F81-41C8-9D2A-47F9ACAF6CBD"
               Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCR" Key="Directory\shell\SphaeraCommander"
                     Value="Открыть в Sphaera Commander" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCR" Key="Directory\shell\SphaeraCommander"
                     Name="Icon" Value="[INSTALLFOLDER]SphaeraCommander.exe" Type="string" />
      <RegistryValue Root="HKCR" Key="Directory\shell\SphaeraCommander\command"
                     Value='"[INSTALLFOLDER]SphaeraCommander.exe" "%1"' Type="string" />
    </Component>

    <Feature Id="Main" Title="Sphaera Commander"
             Description="Двухпанельный файловый менеджер"
             Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="DirAssociation" />
      <ComponentRef Id="PTSerifFont" />
      <ComponentRef Id="FontLicense" />
    </Feature>
  </Package>
</Wix>
